{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON",
        "FLASHFS_BUILD_TESTS": "ON",
        "FLASHFS_BUILD_EXAMPLES": "ON",
        "CMAKE_C_FLAGS": "-g -Wall -Wextra -Werror -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "ubsan",
      "binaryDir": "${sourceDir}/build/ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON",
        "FLASHFS_BUILD_TESTS": "ON",
        "FLASHFS_BUILD_EXAMPLES": "ON",
        "CMAKE_C_FLAGS": "-g -Wall -Wextra -Werror -fsanitize=undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "ubsan-clang",
      "binaryDir": "${sourceDir}/build/ubsan-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON",
        "FLASHFS_BUILD_TESTS": "ON",
        "FLASHFS_BUILD_EXAMPLES": "ON",
        "CMAKE_C_FLAGS": "-g -Wall -Wextra -Werror -fsanitize=undefined,integer,nullability,implicit-conversion -fno-sanitize=unsigned-integer-overflow,implicit-integer-sign-change,implicit-unsigned-integer-truncation,unsigned-shift-base -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "msvc",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "FLASHFS_BUILD_TESTS": "ON",
        "FLASHFS_BUILD_EXAMPLES": "ON",
        "CMAKE_C_FLAGS": "/W4 /WX"
      }
    },
    {
      "name": "fuzz",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "FLASHFS_BUILD_FUZZ": "ON",
        "CMAKE_C_FLAGS": "-g -fsanitize=fuzzer-no-link,address,undefined"
      }
    },
    {
      "name": "fuzz-ubsan",
      "binaryDir": "${sourceDir}/build/fuzz-ubsan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "FLASHFS_BUILD_FUZZ": "ON",
        "CMAKE_C_FLAGS": "-g -O1 -fsanitize=fuzzer-no-link,undefined -fno-sanitize-recover=all"
      }
    },
    {
      "name": "abi",
      "binaryDir": "${sourceDir}/build/abi",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_C_FLAGS": "-g -Og"
      }
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan-clang",
      "configurePreset": "ubsan-clang",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
