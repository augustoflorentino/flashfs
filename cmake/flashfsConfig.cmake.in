@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_flashfs_codecs "@FLASHFS_CODECS@")
if(NOT "@BUILD_SHARED_LIBS@")
    if("zlib" IN_LIST _flashfs_codecs)
        find_dependency(ZLIB)
    endif()
    if("lzma" IN_LIST _flashfs_codecs)
        find_dependency(LibLZMA)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/flashfsTargets.cmake")
check_required_components(flashfs)
